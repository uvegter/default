# Copy to .env and `export` the values (or set them in your shell). Never commit real keys.
# With no key the app runs in demo mode: built-in parser, built-in wording, no model calls.

# ANTHROPIC_API_KEY=            # enables Claude-assisted syllabus extraction
# DD_LLM_MODEL=claude-opus-5-5  # model used by the adapter
# DD_LLM_EXTRACT=1              # default for the "use Claude to read the document" tick-box (1/0)
# DD_LLM_COPY=0                 # 1 = let Claude re-word option descriptions (validated; off by default)
# DD_DISABLE_LLM=1              # force demo mode even if a key is present
# DD_DB_PATH=data/sessions.sqlite3
# DD_CONFIG_DIR=config
